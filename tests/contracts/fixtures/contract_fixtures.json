  "capability_flow_fixtures": [
    {
      "name": "flow_simple_success",
      "module": "tools",
      "steps": [
        {
          "action": "android_tap",
          "params": {
            "x": 100,
            "y": 200
          },
          "verifier": "screen_changed"
        }
      ],
      "handler_results": {
        "android_tap": {
          "success": true
        },
        "screen_changed": {
          "outcome": "confirmed",
          "observer": "screen_hash"
        }
      },
      "expected_status": "success",
      "required_keys": [
        "status",
        "trace"
      ]
    },
    {
      "name": "flow_verification_failed",
